# Copy to .env (never commit it) and fill in.

# Soulseek account: pick any free username/password, the account is created on first login.
SLSK_USERNAME=
SLSK_PASSWORD=

# slskd API key shared with bandcamp-sync. Generate: openssl rand -hex 24
SLSKD_API_KEY=

# Soulseek listen port (router forward: same port, TCP, to this PC). Below 49152, see docker-compose.yml.
# SLSK_LISTEN_PORT=45300

# Host user that owns ./data
PUID=1000
PGID=1000

# Bandcamp (bandcamp-sync)
BANDCAMP_USER=
# Only for a private wishlist (value of the `identity` cookie). Leave empty otherwise.
BANDCAMP_IDENTITY=

# --- bandcamp-sync (all optional, defaults shown) ---
# DATA_DIR=data                 # master/, review/, replaced/, covers/ and state.db live here
# SYNC_LIMIT=30                 # max pending tracks per run (compose default; empty = all outside Docker)
# SCRIPT_INTERVAL=10800         # seconds between runs (3 h in compose); empty = run once
# DOWNLOAD_WORKERS=3            # tracks handled in parallel (like the slskd GUI); 1 = one at a time
# SEARCH_GAP_S=3                # minimum pause between two Soulseek searches (searches are never parallel)
# RETRY_BASE_H=1                # a track with no result waits 1 h, then 2, 4, 8... h
# RETRY_MAX_H=24                # ...but never more than this
# GATE_RULE=both                # lv | either | both | fc_judge | none (none = no anti-transcode check at all)
# MAX_SOURCE_TRIES=3            # different peers tried when a copy is refused
# QUEUE_TIMEOUT_S=180           # first pass: wait this long for a transfer to start, then fall back
# UPGRADE=1                     # look for lossless copies of the MP3 fallbacks
# UPGRADE_LIMIT=10              # tracks searched per run
# UPGRADE_INTERVAL_H=24         # do not search the same track again within this time
# BLOCKED_PEERS=            # Soulseek users never used as a source, comma separated (e.g. a peer that charges for downloads)
# CONSENSUS_MIN=3  # a refused copy is accepted when >= N tracks of the same folder of the same peer passed the gate (majority needed); 0 = off
# NOT_FOUND_RETRY_H=7           # a track not found is searched again after this long (not 24: other hours get covered)
# UPGRADE_QUEUE_TIMEOUT_S=30    # upgrade: wait this long, then leave the transfer queued
# QUEUE_MAX_AGE_DAYS=7          # give up on a transfer that waits longer than this
# DELETE_REPLACED=0             # 1 = delete the replaced MP3 instead of moving it to data/replaced
# KEEP_ORIGINALS=0              # 1 = keep the intermediate FLAC in data/originals
